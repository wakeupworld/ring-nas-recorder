# No token here: run `docker compose run --rm ring-nas-recorder auth` once,
# which writes ./data/refresh-token (mode 600).

TZ=America/New_York
PUID=568
PGID=568

# Comma-separated camera names or ids; empty = all cameras.
CAMERAS=
# motion, ding, or both.
TRIGGERS=motion,ding
CLIP_SECONDS=45
COOLDOWN_SECONDS=15
MAX_CONCURRENT_STREAMS=2

# Optional scheduled continuous recording (wired cameras recommended).
CONTINUOUS_CAMERAS=
CONTINUOUS_SCHEDULE=off
SEGMENT_SECONDS=300

# Delete clips older than N days (0 = keep forever) and keep this much space free.
RETENTION_DAYS=30
MIN_FREE_GB=20

DRY_RUN=false
DEBUG=false
